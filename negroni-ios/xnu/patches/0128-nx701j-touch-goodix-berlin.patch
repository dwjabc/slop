diff --git a/bsd/dev/negroni_touch/goodix_berlin.h b/bsd/dev/negroni_touch/goodix_berlin.h
new file mode 100644
index 0000000..3528092
--- /dev/null
+++ b/bsd/dev/negroni_touch/goodix_berlin.h
@@ -0,0 +1,167 @@
+/*
+ * Goodix Berlin protocol (GT9916) over an I2C bus handle.
+ * Register map per the mainline Linux goodix_berlin driver; the IC boots from
+ * internal flash, so no config/firmware download is needed for plain touch.
+ * nx701j: GT9916 at 0x5d on the SE4 GPIO I2C bus (same pins as the S3908).
+ */
+#ifndef GOODIX_BERLIN_H
+#define GOODIX_BERLIN_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define GB_ADDR             0x5du
+#define GB_BOOTOPTION       0x10000u
+#define GB_DEV_CONFIRM_VAL  0xaau
+#define GB_FW_VERSION_ADDR  0x1000cu  /* A variant */
+#define GB_IC_INFO_ADDR     0x10068u  /* A variant */
+#define GB_IC_INFO_MAX_LEN  512u
+#define GB_MAX_TOUCH        10u
+#define GB_CKSUM_SIZE       2u
+#define GB_HEADER_SIZE      8u
+#define GB_POINT_SIZE       8u
+
+struct gb_io {
+	void *ctx;
+	int (*read)(void *ctx, uint8_t *buf, uint32_t len);
+	int (*write)(void *ctx, const uint8_t *buf, uint32_t len);
+};
+
+struct gb_point {
+	uint8_t status;
+	uint8_t reserved;
+	uint16_t x, y, w;
+};
+
+struct gb {
+	struct gb_io io;
+	uint32_t touch_data_addr;
+	uint8_t patch_pid[8];
+};
+
+static inline int
+gb_write(struct gb *g, uint32_t reg, const uint8_t *buf, uint32_t len)
+{
+	uint8_t tmp[2 + 512];
+	if (len > sizeof(tmp) - 2)
+		return -1;
+	tmp[0] = (uint8_t)(reg >> 8);
+	tmp[1] = (uint8_t)reg;
+	for (uint32_t i = 0; i < len; i++)
+		tmp[2 + i] = buf[i];
+	return g->io.write(g->io.ctx, tmp, 2 + len);
+}
+
+static inline int
+gb_read(struct gb *g, uint32_t reg, uint8_t *buf, uint32_t len)
+{
+	uint8_t ptr[2] = { (uint8_t)(reg >> 8), (uint8_t)reg };
+	int rc = g->io.write(g->io.ctx, ptr, 2);
+	if (rc)
+		return rc;
+	return g->io.read(g->io.ctx, buf, len);
+}
+
+static inline uint16_t
+gb_cksum(const uint8_t *buf, uint32_t size)
+{
+	uint16_t s = 0;
+	for (uint32_t i = 0; i + GB_CKSUM_SIZE <= size; i++)
+		s = (uint16_t)(s + buf[i]);
+	return s;
+}
+
+/* Write 8x 0xAA to the bootoption register and read it back. */
+static inline int
+gb_confirm(struct gb *g)
+{
+	uint8_t tx[8], rx[8];
+	memset(tx, GB_DEV_CONFIRM_VAL, sizeof(tx));
+	for (int retry = 0; retry < 3; retry++) {
+		int rc = gb_write(g, GB_BOOTOPTION, tx, sizeof(tx));
+		if (rc)
+			return rc;
+		rc = gb_read(g, GB_BOOTOPTION, rx, sizeof(rx));
+		if (rc)
+			return rc;
+		if (memcmp(tx, rx, sizeof(tx)) == 0)
+			return 0;
+	}
+	return -1;
+}
+
+/* 28-byte fw version block at 0x1000C; patch PID at bytes 12..19. */
+static inline int
+gb_read_version(struct gb *g)
+{
+	uint8_t buf[28];
+	int rc = gb_read(g, GB_FW_VERSION_ADDR, buf, sizeof(buf));
+	if (rc)
+		return rc;
+	if (gb_cksum(buf, sizeof(buf)) != (uint16_t)(buf[26] | (buf[27] << 8)))
+		return -2;
+	memcpy(g->patch_pid, buf + 12, 8);
+	return 0;
+}
+
+/* IC info at 0x10068: skip the fixed headers and the variable parameter
+ * lists, then read touch_data_addr out of the misc block. */
+static inline int
+gb_parse_ic_info(struct gb *g)
+{
+	uint8_t buf[GB_IC_INFO_MAX_LEN];
+	int rc = gb_read(g, GB_IC_INFO_ADDR, buf, sizeof(buf));
+	if (rc)
+		return rc;
+
+	uint32_t off = 2;                        /* length le16 */
+	off += 11;                               /* ic_info_version */
+	off += 10;                               /* ic_info_feature */
+	off += 4;                                /* drv/sen/button/force num */
+	if (off >= sizeof(buf))
+		return -3;
+	for (int i = 0; i < 5; i++) {            /* 5x le16 param lists */
+		uint8_t n = buf[off++];
+		off += (uint32_t)n * 2;
+		if (off >= sizeof(buf))
+			return -3;
+	}
+	off += 42;                               /* misc fields before touch_data_addr */
+	if (off + 4 > sizeof(buf))
+		return -3;
+	g->touch_data_addr = (uint32_t)buf[off] | ((uint32_t)buf[off + 1] << 8) |
+	    ((uint32_t)buf[off + 2] << 16) | ((uint32_t)buf[off + 3] << 24);
+	return g->touch_data_addr ? 0 : -4;
+}
+
+/* Read one event at touch_data_addr. Returns the touch count (>=0) with
+ * points filled, 0 when no event, negative on bus/checksum error. */
+static inline int
+gb_read_event(struct gb *g, struct gb_point *pts, unsigned max)
+{
+	uint8_t buf[GB_HEADER_SIZE + GB_POINT_SIZE * GB_MAX_TOUCH + GB_CKSUM_SIZE];
+	int rc = gb_read(g, g->touch_data_addr, buf, sizeof(buf));
+	if (rc)
+		return rc;
+	uint16_t want = (uint16_t)(buf[6] | (buf[7] << 8));
+	if (gb_cksum(buf, sizeof(buf)) != want)
+		return -2;
+	if (!(buf[0] & 0x80u))
+		return 0;                        /* no touch event */
+
+	unsigned count = buf[0] & 0x0fu;
+	if (count > max)
+		count = max;
+	for (unsigned i = 0; i < count; i++) {
+		const uint8_t *p = buf + GB_HEADER_SIZE + i * GB_POINT_SIZE;
+		pts[i].status = p[0];
+		pts[i].x = (uint16_t)(p[2] | (p[3] << 8));
+		pts[i].y = (uint16_t)(p[4] | (p[5] << 8));
+		pts[i].w = (uint16_t)(p[6] | (p[7] << 8));
+	}
+	static const uint8_t zero[4];
+	(void)gb_write(g, g->touch_data_addr, zero, 4);
+	return (int)count;
+}
+
+#endif /* GOODIX_BERLIN_H */
